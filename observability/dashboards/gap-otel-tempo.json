      "options": {
        "overrides": [
          { "properties": [], "matcher": { "id": "byName", "options": "service" } }
        ],
        "search": { "query": "status.code = 2 AND duration > 100ms", "limit": 20, "filters": [] },
        "serviceNameQuery": "",
        "traceIdQuery": ""
