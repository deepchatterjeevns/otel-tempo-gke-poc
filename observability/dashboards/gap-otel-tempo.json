      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "query": "status.code = 2 AND duration > 100ms",
          "queryType": "traceSearch",
          "limit": 20
        }
      ],
      "title": "Trace search: slow + erroring traces (click to open waterfall)",
      "type": "traces"
